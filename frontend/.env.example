# Server-side proxy target for `npm run dev`. Browser requests go to /api/* and
# Next forwards them here. Use localhost when running the API via docker compose
# on the host; use http://api:8000 only inside the frontend container.
API_PROXY_TARGET=http://localhost:8000

# Optional — if set, the browser calls this URL directly instead of /api.
# Leave unset to use the relative /api proxy (recommended).
# NEXT_PUBLIC_API_URL=http://localhost:8000
