{
  "name": "haputele-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check:dob": "node --experimental-strip-types scripts/check-dob-date.mjs",
    "check:calendar": "node --experimental-strip-types scripts/check-calendar-date.mjs",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "generate:api": "python3 ../backend/app/scripts/export_openapi.py openapi.json && kubb generate"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.5",
    "@hookform/resolvers": "7.0.7",
    "@livekit/components-react": "2.9.25",
    "@livekit/components-styles": "1.2.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query": "5.108.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "framer-motion": "14.14.0",
    "livekit-client": "2.24.1",
    "lucide-react": "1.77.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-image-crop": "11.1.2",
    "tailwind-merge": "3.7.1",
    "temporal-polyfill": "1.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource/inter": "5.3.0",
    "@kubb/plugin-fetch": "^6.4.0",
    "@kubb/plugin-react-query": "^5.13.0",
    "@kubb/plugin-ts": "^5.6.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "kubb": "^5.23.4",
    "msw": "3.0.7",
    "msw-storybook-addon": "3.0.3",
    "postcss": "8.5.33",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.2"
    },
    "@kubb/react-fabric": {
      "ws@8.18.0": "^8.21.0"
    },
    "next": {
      "postcss": "8.5.26"
    },
    "sharp": "^0.35.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
