{
  "name": "haputele-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check:dob": "node --experimental-strip-types scripts/check-dob-date.mjs",
    "check:calendar": "node --experimental-strip-types scripts/check-calendar-date.mjs",
    "generate:api": "python3 ../backend/app/scripts/export_openapi.py openapi.json && kubb generate"
  },
  "dependencies": {
    "@fullcalendar/react": "7.0.2",
    "@hookform/resolvers": "5.9.1",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.102.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "framer-motion": "13.1.1",
    "livekit-client": "2.22.1",
    "lucide-react": "1.34.0",
    "luxon": "^3.7.2",
    "next": "16.3.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-image-crop": "11.1.2",
    "tailwind-merge": "3.6.0",
    "temporal-polyfill": "1.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@kubb/plugin-fetch": "^5.1.0",
    "@kubb/plugin-react-query": "^5.0.0",
    "@kubb/plugin-ts": "^5.0.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "kubb": "^5.0.2",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "sharp": "^0.35.3"
  }
}
